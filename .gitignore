# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files (usually local-only overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore key files and installers
*.pem
*.pub
terra-key-ec2*
awscliv2.zip